# Edit /etc/sonic/inspire-hands.env for this robot before starting the service.
NETWORK_INTERFACE=eth0
DDS_DOMAIN=0
RIGHT_ID=1
LEFT_ID=1
# Replace these with the robot's stable FTDI by-id paths (right if01, left if02
# for the G1-style adapter). Do not use another robot's USB serial number.
RIGHT_PORT=/dev/serial/by-id/REPLACE_WITH_RIGHT_HAND_PORT
LEFT_PORT=/dev/serial/by-id/REPLACE_WITH_LEFT_HAND_PORT

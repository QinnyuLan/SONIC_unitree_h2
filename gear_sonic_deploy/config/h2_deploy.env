# H2 sim2real 专用配置；修改保存后重启实机控制脚本生效。
# 路径相对于 gear_sonic_deploy；也可以写绝对路径。
# 正式发布模型；三个主流程共用同一 encoder/decoder。
MODEL=../models/released

# H2 动作：reference/example_h2/deploy（selector 0）
# 常规 SONIC demo：reference/example（selector 3，仍控制 H2 本体）
# 探索动作（非默认）：reference/example_g1_explore
# SMPL 动作：reference/example_smpl_h2/deploy（selector 2）
MOTION_DATA=reference/example
INITIAL_MOTION=""  # 留空从集合默认动作开始；也可写 squat_001__A359 等名称

# 只缩放 Kp，不缩放 Kd。保留此前实机脚本的值。
LEFT_ANKLE_KP=1.2    # 最终 Kp = 40 × 此值
RIGHT_ANKLE_KP=1.4   # 最终 Kp = 40 × 此值
LEFT_ANKLE_ROLL_KP=0.7   # 左脚踝 roll：最终 Kp = 40 × 此值
RIGHT_ANKLE_ROLL_KP=0.7  # 右脚踝 roll：最终 Kp = 40 × 此值
LEFT_KNEE_KP=1.2     # 最终 Kp = 200 × 此值
RIGHT_KNEE_KP=1.2    # 最终 Kp = 200 × 此值

NETWORK_INTERFACE=eno1  # 仅 sim2real；sim2sim 固定使用 sim/loopback
DDS_DOMAIN=0           # 实机 DDS domain
LOG_ROOT=logs

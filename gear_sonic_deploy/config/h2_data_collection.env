# H2 + DFX/Inspire VLA 采集配置（仅采集器使用，不改变机器人控制）。
# 每一批任务开始前填写准确的任务描述；CHANGE_ME 会阻止启动，避免错误标签。
TASK_PROMPT='ROBO_IN_BOX'
# 路径相对于 gear_sonic_deploy。建议改到空间充足的数据盘。
DATASET_ROOT=../datasets/h2_teleop/20260919
RECORD_FPS=50
RGB_PORT=5002
RGB_WIDTH=1920
RGB_HEIGHT=1080
MIN_FREE_GB=2
# 相机标定 JSON 路径；留空明确记录为“未提供”，不会伪造内参/外参。
CAMERA_CALIBRATION=''
# 0：带第一视角和录制状态预览；1：无窗口，仅终端。
HEADLESS=0
TELEOP_ADDRESS=tcp://127.0.0.1:5556
STATE_ADDRESS=tcp://127.0.0.1:5557
